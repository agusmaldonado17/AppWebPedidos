@page "/platos/nuevo"

@using AppWebPedidos.Data
@using AppWebPedidos.Models
@using AppWebPedidos.Components.Layout
@using Microsoft.EntityFrameworkCore

@layout AdminLayout

@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Navigation
@inject IWebHostEnvironment Env

<PageTitle>Nuevo plato</PageTitle>


<div class="sp-admin-form-wrapper">

    <a href="/platos"
       class="sp-admin-back">
        ← Volver a platos
    </a>


    <div class="sp-admin-page-header">

        <div>

            <h1>Nuevo plato</h1>

            <p>
                Agregá un nuevo producto a la carta.
            </p>

        </div>

    </div>


    @if (categorias.Count == 0)
    {
        <div class="alert alert-warning">

            Primero tenés que crear al menos
            una categoría activa.

        </div>

        <a href="/categorias"
           class="btn btn-primary">
            Ir a categorías
        </a>
    }
    else
    {
        <div class="sp-admin-form-card">

            <h2>Datos del plato</h2>

            <p class="sp-admin-form-description">
                Completá la información que se mostrará
                en la carta del cliente.
            </p>


            <EditForm Model="plato"
                      OnValidSubmit="GuardarPlato">

                <DataAnnotationsValidator />

                <ValidationSummary />


                <!-- CATEGORÍA -->

                <div class="mb-4">

                    <label class="sp-admin-form-label">
                        Categoría
                    </label>

                    <InputSelect class="form-select"
                                 @bind-Value="plato.IdCategoria">

                        <option value="0">
                            Seleccione una categoría
                        </option>

                        @foreach (var categoria in categorias)
                        {
                            <option value="@categoria.IdCategoria">
                                @categoria.Nombre
                            </option>
                        }

                    </InputSelect>

                    <ValidationMessage For="@(() => plato.IdCategoria)" />

                </div>


                <!-- NOMBRE -->

                <div class="mb-4">

                    <label class="sp-admin-form-label">
                        Nombre
                    </label>

                    <InputText class="form-control"
                               @bind-Value="plato.Nombre"
                               placeholder="Ej: Pizza Margarita" />

                    <ValidationMessage For="@(() => plato.Nombre)" />

                </div>


                <!-- DESCRIPCIÓN -->

                <div class="mb-4">

                    <label class="sp-admin-form-label">
                        Descripción
                    </label>

                    <InputTextArea class="form-control"
                                   @bind-Value="plato.Descripcion"
                                   rows="4"
                                   placeholder="Ingredientes o descripción del plato..." />

                    <ValidationMessage For="@(() => plato.Descripcion)" />

                </div>


                <!-- PRECIO -->

                <div class="mb-4">

                    <label class="sp-admin-form-label">
                        Precio
                    </label>

                    <InputNumber class="form-control"
                                 @bind-Value="plato.Precio" />

                    <ValidationMessage For="@(() => plato.Precio)" />

                </div>


                <!-- IMAGEN -->

                <div class="mb-4">

                    <label class="sp-admin-form-label">
                        Imagen
                    </label>

                    <div class="sp-upload-box">

                        <InputFile class="form-control"
                                   OnChange="CargarImagen"
                                   accept=".jpg,.jpeg,.png,.webp" />

                        <small>
                            JPG, JPEG, PNG o WEBP.
                            Máximo 5 MB.
                        </small>

                    </div>


                    @if (!string.IsNullOrWhiteSpace(mensajeImagen))
                    {
                        <div class="text-danger mt-2">
                            @mensajeImagen
                        </div>
                    }


                    @if (!string.IsNullOrWhiteSpace(plato.ImagenUrl))
                    {
                        <div class="mt-3">

                            <span class="sp-admin-form-label">
                                Vista previa
                            </span>

                            <img src="@plato.ImagenUrl"
                                 alt="Vista previa"
                                 class="sp-image-preview mt-2" />

                        </div>
                    }

                </div>


                <!-- DISPONIBLE -->

                <div class="form-check">

                    <InputCheckbox class="form-check-input"
                                   @bind-Value="plato.Disponible" />

                    <label class="form-check-label">
                        Disponible en la carta
                    </label>

                </div>


                <!-- BOTONES -->

                <div class="sp-admin-form-actions">

                    <button type="submit"
                            class="btn btn-primary">

                        Guardar plato

                    </button>


                    <a href="/platos"
                       class="btn btn-outline-primary">

                        Cancelar

                    </a>

                </div>

            </EditForm>

        </div>
    }

</div>


@code {

    private Plato plato = new()
    {
        Disponible = true
    };


    private List<Categoria> categorias = new();

    private string? mensajeImagen;


    protected override async Task OnInitializedAsync()
    {
        await using var db =
            await DbFactory.CreateDbContextAsync();


        categorias = await db.Categorias
            .Where(c => c.Activo)
            .OrderBy(c => c.Nombre)
            .AsNoTracking()
            .ToListAsync();
    }


    private async Task CargarImagen(
        InputFileChangeEventArgs e)
    {
        mensajeImagen = null;


        var archivo = e.File;


        var extension = Path
            .GetExtension(archivo.Name)
            .ToLowerInvariant();


        string[] extensionesPermitidas =
        {
            ".jpg",
            ".jpeg",
            ".png",
            ".webp"
        };


        if (!extensionesPermitidas.Contains(extension))
        {
            mensajeImagen =
                "Formato de imagen no permitido.";

            return;
        }


        const long tamanoMaximo =
            5 * 1024 * 1024;


        if (archivo.Size > tamanoMaximo)
        {
            mensajeImagen =
                "La imagen no puede superar los 5 MB.";

            return;
        }


        var nombreArchivo =
            $"{Guid.NewGuid()}{extension}";


        var carpeta =
            Path.Combine(
                Env.WebRootPath,
                "images",
                "platos"
            );


        Directory.CreateDirectory(carpeta);


        var rutaArchivo =
            Path.Combine(
                carpeta,
                nombreArchivo
            );


        await using var stream =
            new FileStream(
                rutaArchivo,
                FileMode.Create
            );


        await archivo
            .OpenReadStream(tamanoMaximo)
            .CopyToAsync(stream);


        plato.ImagenUrl =
            $"/images/platos/{nombreArchivo}";
    }


    private async Task GuardarPlato()
    {
        await using var db =
            await DbFactory.CreateDbContextAsync();


        db.Platos.Add(plato);


        await db.SaveChangesAsync();


        Navigation.NavigateTo("/platos");
    }

}