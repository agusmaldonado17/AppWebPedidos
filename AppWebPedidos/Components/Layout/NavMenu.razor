@using AppWebPedidos.Services

@inject CarritoService CarritoSvc

@implements IDisposable

<header class="sp-navbar">

    <div class="sp-navbar-inner">

        <NavLink class="sp-brand"
                 href="/cliente">

            <span class="sp-brand-icon">
                ◆
            </span>

            <div>
                <div class="sp-brand-name">
                    Pedidos
                </div>

                <div class="sp-brand-subtitle">
                    DELIVERY DE COMIDA
                </div>
            </div>

        </NavLink>


        <nav class="sp-nav-links">

            <NavLink class="sp-nav-link"
                     href="/cliente"
                     Match="NavLinkMatch.All">

                Inicio

            </NavLink>


            <NavLink class="sp-nav-link"
                     href="/carta">

                Carta

            </NavLink>

        </nav>


        <div class="sp-nav-actions">

            <a href="/"
               class="sp-change-panel">
                Cambiar panel
            </a>


            <NavLink href="/carrito"
                     class="sp-cart-button">

                <span class="sp-cart-icon">
                    🛒
                </span>


                @if (CarritoSvc.CantidadTotal > 0)
                {
                    <span class="sp-cart-count">
                        @CarritoSvc.CantidadTotal
                    </span>
                }

            </NavLink>

        </div>

    </div>

</header>


@code {

    protected override void OnInitialized()
    {
        CarritoSvc.OnChange += Actualizar;
    }


    private void Actualizar()
    {
        _ = InvokeAsync(StateHasChanged);
    }


    public void Dispose()
    {
        CarritoSvc.OnChange -= Actualizar;
    }

}