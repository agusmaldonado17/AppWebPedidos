@page "/categorias"

@using AppWebPedidos.Data
@using AppWebPedidos.Models
@using Microsoft.EntityFrameworkCore
@using AppWebPedidos.Components.Layout

@layout AdminLayout

@inject IDbContextFactory<AppDbContext> DbFactory

<PageTitle>Categorías</PageTitle>


<div class="sp-admin-page-header">

    <div>

        <h1>
            Categorías
        </h1>

        <p>
            Organizá los productos disponibles en la carta.
        </p>

    </div>


    <a href="/categorias/nueva"
       class="btn btn-primary">

        + Nueva categoría

    </a>

</div>


@if (categorias is null)
{
    <p>Cargando categorías...</p>
}
else if (categorias.Count == 0)
{
    <div class="alert alert-light">
        No hay categorías registradas.
    </div>
}
else
{
    <div class="sp-admin-table-card">

        <div class="table-responsive">

            <table class="table sp-admin-table">

                <thead>

                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>Descripción</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>

                </thead>


                <tbody>

                    @foreach (var categoria in categorias)
                    {
                        <tr>

                            <td>
                                #@categoria.IdCategoria
                            </td>


                            <td>

                                <strong>
                                    @categoria.Nombre
                                </strong>

                            </td>


                            <td>
                                @categoria.Descripcion
                            </td>


                            <td>

                                @if (categoria.Activo)
                                {
                                    <span class="sp-status sp-status-confirmado">
                                        Activa
                                    </span>
                                }
                                else
                                {
                                    <span class="sp-status sp-status-cancelado">
                                        Inactiva
                                    </span>
                                }

                            </td>


                            <td>

                                <div class="sp-action-group">

                                    <a href="/categorias/editar/@categoria.IdCategoria"
                                       class="sp-action-button sp-action-edit">

                                        Editar

                                    </a>


                                    <a href="/categorias/eliminar/@categoria.IdCategoria"
                                       class="sp-action-button sp-action-delete">

                                        Eliminar

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>
}


@code {

    private List<Categoria>? categorias;


    protected override async Task OnInitializedAsync()
    {
        await using var db =
            await DbFactory.CreateDbContextAsync();

        categorias = await db.Categorias
            .AsNoTracking()
            .OrderBy(c => c.Nombre)
            .ToListAsync();
    }

}