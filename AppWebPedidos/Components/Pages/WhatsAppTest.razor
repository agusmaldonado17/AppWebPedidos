@page "/whatsapp-test"

@using AppWebPedidos.Services

@inject IWhatsAppService WhatsAppService

<PageTitle>Prueba WhatsApp</PageTitle>

<div class="container py-5">

    <h1>Prueba de WhatsApp</h1>

    <p>
        Enviá el mensaje de prueba hello_world
        utilizando WhatsApp Cloud API.
    </p>

    <div class="card p-4 mt-4"
         style="max-width: 600px;">

        <div class="mb-3">

            <label class="form-label">
                Número de WhatsApp
            </label>

            <input class="form-control"
                   @bind="telefono"
                   placeholder="Ej: 5492954123456" />

            <div class="form-text">
                Usá el mismo número que agregaste como
                destinatario de prueba en Meta.
            </div>

        </div>


        <button class="btn btn-primary"
                @onclick="EnviarMensaje"
                disabled="@enviando">

            @(enviando
                ? "Enviando..."
                : "Enviar mensaje de prueba")

        </button>


        @if (!string.IsNullOrWhiteSpace(mensajeExito))
        {
            <div class="alert alert-success mt-3">
                @mensajeExito
            </div>
        }


        @if (!string.IsNullOrWhiteSpace(mensajeError))
        {
            <div class="alert alert-danger mt-3">

                <strong>Error:</strong>

                <br />

                @mensajeError

            </div>
        }

    </div>

</div>


@code {

    private string telefono = string.Empty;

    private bool enviando;

    private string? mensajeExito;

    private string? mensajeError;


    private async Task EnviarMensaje()
    {
        mensajeExito = null;
        mensajeError = null;


        if (string.IsNullOrWhiteSpace(telefono))
        {
            mensajeError =
                "Ingresá un número de teléfono.";

            return;
        }


        try
        {
            enviando = true;


            await WhatsAppService
                .EnviarHelloWorldAsync(telefono);


            mensajeExito =
                "Mensaje enviado correctamente.";
        }
        catch (Exception ex)
        {
            mensajeError =
                ex.Message;
        }
        finally
        {
            enviando = false;
        }
    }

}