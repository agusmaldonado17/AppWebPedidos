@page "/"

@using AppWebPedidos.Components.Layout

@layout PortalLayout

<PageTitle>Pedidos</PageTitle>

<section class="sp-portal">

    <div class="sp-portal-container">

        <div class="sp-portal-header">

            <div class="sp-portal-logo">
                ◆
            </div>

            <h1>
                Pedidos
            </h1>

            <p class="sp-portal-subtitle">
                DELIVERY DE COMIDA
            </p>

            <p class="sp-portal-description">
                Seleccioná el panel al que querés ingresar.
            </p>

        </div>


        <div class="row g-4 justify-content-center">

            <!-- CLIENTE -->

            <div class="col-md-6 col-lg-5">

                <div class="sp-access-card">

                    <div class="sp-access-icon client">
                        🍽️
                    </div>

                    <span class="sp-access-label">
                        RESTAURANTE
                    </span>

                    <h2>
                        Panel cliente
                    </h2>

                    <p>
                        Explorá la carta, elegí tus platos
                        y armá tu pedido.
                    </p>

                    <div class="sp-access-features">

                        <span>✓ Ver carta</span>
                        <span>✓ Filtrar categorías</span>
                        <span>✓ Agregar al carrito</span>
                        <span>✓ Confirmar pedido</span>

                    </div>

                    <a href="/cliente"
                       class="btn btn-primary btn-lg w-100">

                        Ingresar como cliente →

                    </a>

                </div>

            </div>


            <!-- ADMIN -->

            <div class="col-md-6 col-lg-5">

                <div class="sp-access-card admin">

                    <div class="sp-access-icon admin">
                        ⚙️
                    </div>

                    <span class="sp-access-label">
                        ADMINISTRACIÓN
                    </span>

                    <h2>
                        Panel administrador
                    </h2>

                    <p>
                        Administrá la carta y gestioná
                        los pedidos del restaurante.
                    </p>

                    <div class="sp-access-features">

                        <span>✓ Categorías</span>
                        <span>✓ Platos</span>
                        <span>✓ Pedidos</span>
                        <span>✓ Estados</span>

                    </div>

                    <a href="/admin"
                       class="btn btn-accent btn-lg w-100">

                        Ingresar al administrador →

                    </a>

                </div>

            </div>

        </div>


        <div class="sp-portal-note">

            <span>●</span>

            Acceso de demostración — no requiere autenticación

        </div>

    </div>

</section>